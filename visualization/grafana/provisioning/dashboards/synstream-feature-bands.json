{
  "uid": "synstream-feature-bands",
  "title": "SynStream - Feature bands (t-digest)",
  "tags": [
    "synstream",
    "document-49"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "dataset",
        "label": "Dataset",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.measurementTagValues(bucket: \"synstream_bucket\", measurement: \"feature_bands\", tag: \"dataset\")",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "sort": 1
      },
      {
        "name": "sensor",
        "label": "Sensor",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.measurementTagValues(bucket: \"synstream_bucket\", measurement: \"feature_bands\", tag: \"sensor\")",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "sort": 1
      },
      {
        "name": "feature",
        "label": "Feature",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.measurementTagValues(bucket: \"synstream_bucket\", measurement: \"feature_bands\", tag: \"feature\")",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "${feature} of ${sensor}: value and t-digest band",
      "description": "Solid = current value. Dashed = p05 / p95, dotted = p25 / p75, computed from past values only (t-digest, Dunning & Ertl 2019).",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "value"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p05"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p25"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dot"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p75"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dot"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"synstream_bucket\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"feature_bands\" and (r._field == \"value\" or r._field == \"p05\" or r._field == \"p25\" or r._field == \"p50\" or r._field == \"p75\" or r._field == \"p95\"))\n  |> filter(fn: (r) => r.dataset == \"${dataset}\" and r.sensor == \"${sensor}\" and r.feature == \"${feature}\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Windows outside the p05-p95 band",
      "description": "Number of windows per interval whose value is outside the band.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"synstream_bucket\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"feature_bands\" and (r._field == \"outside_band\"))\n  |> filter(fn: (r) => r.dataset == \"${dataset}\" and r.sensor == \"${sensor}\" and r.feature == \"${feature}\")\n  |> map(fn: (r) => ({r with _value: if r._value then 1 else 0}))\n  |> aggregateWindow(every: v.windowPeriod, fn: sum, createEmpty: false)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Share of windows outside the band",
      "description": "Mean of outside_band over the selected time range (about 10% expected if the stream does not change).",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"synstream_bucket\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"feature_bands\" and (r._field == \"outside_band\"))\n  |> filter(fn: (r) => r.dataset == \"${dataset}\" and r.sensor == \"${sensor}\" and r.feature == \"${feature}\")\n  |> map(fn: (r) => ({r with _value: if r._value then 1.0 else 0.0}))\n  |> mean()"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Values in the digest (n)",
      "description": "Number of values the digest has seen; bands start after 30 values.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 18,
        "y": 10,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"synstream_bucket\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"feature_bands\" and (r._field == \"n\"))\n  |> filter(fn: (r) => r.dataset == \"${dataset}\" and r.sensor == \"${sensor}\" and r.feature == \"${feature}\")\n  |> last()"
        }
      ]
    }
  ]
}